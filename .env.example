# Infomentor Credentials
INFOMENTOR_USERNAME=your_username
INFOMENTOR_PASSWORD=your_password

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CALENDAR_NAME=Barnens skola

# AI Provider (Choose either Gemini or OpenAI / OpenAI-compatible endpoint)
# Option A: Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-flash-latest

# Option B: OpenAI or any OpenAI-compatible API (Ollama, Groq, DeepSeek, OpenRouter, LiteLLM)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Sync settings (days ahead, defaults to 14 = 2 weeks)
SYNC_DAYS_AHEAD=14

# Filter out routine items (comma-separated, case-insensitive)
EXCLUDE_PATTERNS=Studion öppen

# Daily school hours overview events (start- and end times with full daily schedule in description)
SYNC_SCHOOL_HOURS=true

# Child color mapping (Google Calendar color IDs: 9=Blueberry, 10=Basil, 4=Flamingo, 7=Peacock, 3=Grape, 6=Tangerine)
# Leave empty for automatic soft pastel palette assignment (Adam=9 Blueberry, Isak=10 Basil, Leo=4 Flamingo)
# CHILD_COLORS=Adam:9,Isak:10,Leo:4
CHILD_COLORS=

# Gmail Integration (OPTIONAL - Ingest school letters and notices sent to your Gmail from InfoMentor)
# Leave commented out if you do not want to use Gmail integration.
# To generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_SENDER=noreply-se@system.infomentor.se
